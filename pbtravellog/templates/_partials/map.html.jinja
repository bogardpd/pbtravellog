<div id="map" class="mapbox-map"></div>
<script>
  const map = new mapboxgl.Map({
    accessToken: '{{ mapbox_api_key }}',
    container: 'map',
    style: 'mapbox://styles/bogardpd/cly0gib62008301p82kk64np1',
    bounds: {{ gj_map.bounds | tojson }},
    fitBoundsOptions: {
      padding: {top: 40, bottom: 40, left: 40, right: 40},
      minZoom: 0.49, // Min zoom for initial bounds
      maxZoom: 6.00, // Max zoom for initial bounds
    },
  });

  map.on('style.load', () => {
    map.setFog({});
  });

  map.on('load', () => {
    // Load data.
    map.addSource('flights', {
      'type': 'geojson',
      'data': {{ gj_map.geojson | tojson(indent=2) }},
      'generateId': true,
    });
    // Add flights.
    map.addLayer({
      'id': 'routes',
      'type': 'line',
      'source': 'flights',
      'filter': ['==', '$type', 'LineString'],
      'paint': {
        'line-width': 2.0,
        'line-color': '#0077bb',
        'line-opacity': ['case', ['get', 'Highlighted'], 1.0, 0.8],
      }
    });
    // Add airports.
    map.addLayer({
      'id': 'airports',
      'type': 'circle',
      'source': 'flights',
      'filter': ['==', '$type', 'Point'],
      'paint': {
        'circle-radius': 3,
        'circle-color': '#000000',
        'circle-stroke-color': '#0077bb',
        'circle-stroke-width': 1,
      }
    });
    // Add labels.
    map.addLayer({
      'id': 'airport-labels',
      'type': 'symbol',
      'source': 'flights',
      'filter': ['==', '$type', 'Point'],
      'minzoom': 3,
      'layout': {
        'text-field': ['get', 'airport_code'],
        'text-variable-anchor': ['bottom','top','left','right'],
        'text-radial-offset': 0.5,
        'text-font': ['DIN Pro Medium', 'Open Sans Semibold'],
        'text-size': 13,
      },
      'paint': {
        'text-color': '#000000',
        'text-halo-color': '#ffffff',
        'text-halo-width': 1.5,
        'text-halo-blur': 2,
      },
    });
  });
</script>