<table>
  <thead>
    <tr>
      <th class="rank">#</th>
      <th>Route</th>
      <th>Distance</th>
      <th>Flights</th>
    </tr>
  </thead>
  <tbody>
    {% for fids, route in routes.items() %}
    <tr>
      <td class="rank">{% if loop.first or route.get("rank") != loop.previtem[1].get("rank") %}{{ route.get("rank") }}{% else %}⋮{% endif %}</td>
      <td>
        <a href="{{ url_for('show_route', airport_0_fid=fids[0], airport_1_fid=fids[1]) }}">
          <span class="code">{{ route["airports"][0].code() }}</span>
          &harr;
          <span class="code">{{ route["airports"][1].code() }}</span>
        </a>
      </td>
      <td>{% if route.get("distance_mi") is not none %}{{ route["distance_mi"] }}&nbsp;mi{% endif %}</td>
      <td>{{ route.get("count") }}</td>
    </tr>
    {% endfor %}
    <tr class="total">
      <td colspan="4">{{ routes | length }}&nbsp;route{% if (routes | length) != 1 %}s{% endif %}</td>
    </tr>
  </tbody>
</table>