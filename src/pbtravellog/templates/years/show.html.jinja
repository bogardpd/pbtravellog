{% extends "base.html.jinja" %}
{% block title %}{{ year }}{% endblock %}
{% block type %}Year{% endblock %}

{% block card_content %}

  <div class="card-content-general">
    <div><div class="card-label">Flights</div><div>{{ flights | length }}</div></div>
  </div>
  
  {% with gj_map = flights_map %}
    {% include "_partials/map.html.jinja" %}
  {% endwith %}

{% endblock %}

{% block content %}

  <h2>{{ year }} Airlines</h2>
  {% include "_partials/airline_table.html.jinja" %}

  <h2>{{ year }} Operators</h2>
  {% include "_partials/operator_table.html.jinja" %}

  <h2>{{ year }} Aircraft Types</h2>
  {% include "_partials/aircraft_type_table.html.jinja" %}

  <h2>{{ year }} Classes</h2>
  {% include "_partials/class_table.html.jinja" %}

  <h2>{{ year }} Flights</h2>
  {% include "_partials/flight_table.html.jinja" %}

{% endblock content %}
